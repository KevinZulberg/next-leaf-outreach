# Copy this file to .env, then add your own credentials. NEVER commit .env to GitHub.
SMTP_HOST=smtp.hmailplus.com
SMTP_PORT=465
SMTP_USER=you@yourdomain.co.za
SMTP_PASSWORD=replace_with_your_email_password
FLASK_SECRET_KEY=replace_with_random_secret

# Finding businesses (Tavily). Optional OpenAI key is only for the AI drafting helper.
TAVILY_API_KEY=
TAVILY_MONTHLY_CREDITS=1000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Autopilot, Monday to Thursday, Johannesburg time.
# 1) Search for businesses, check their websites and write drafts.
RESEARCH_AUTOMATION=1
RESEARCH_TIME=09:00
# Optional ceiling on searches per day (otherwise credits are spread over the month).
RESEARCH_DAILY_SEARCHES=

# 2) Send automatically. AUTO_APPROVE=1 also sends drafts for businesses found online
#    without a manual approval step. Set it to 0 to send only emails you approved.
AUTO_SEND=1
AUTO_APPROVE=1
AUTO_SEND_TIME=21:00
AUTO_SEND_LIMIT=100
# Seconds between emails (100 emails at 20s is about 35 minutes).
SEND_DELAY_SECONDS=20
