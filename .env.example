# Copy this file to .env and fill in your own details. NEVER commit .env to GitHub.
# Schedule, autopilot on/off, searches per day and emails per day are NOT here:
# change them on the website, under Settings.

# Your HMail Plus mailbox
SMTP_HOST=smtp.hmailplus.com
SMTP_PORT=465
SMTP_USER=you@yourdomain.co.za
SMTP_PASSWORD=replace_with_your_email_password
FLASK_SECRET_KEY=replace_with_random_secret

# Finding businesses (Tavily)
TAVILY_API_KEY=
