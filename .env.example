# Copy this file to .env, then add your own credentials. NEVER commit .env to GitHub.
SMTP_HOST=smtp.hmailplus.com
SMTP_PORT=465
SMTP_USER=you@yourdomain.co.za
SMTP_PASSWORD=replace_with_your_email_password
SEND_DELAY_SECONDS=3
FLASK_SECRET_KEY=replace_with_random_secret

# Optional AI Research Studio credentials (separate paid API accounts):
TAVILY_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Automatic South Africa research (weekdays, Johannesburg time)
RESEARCH_AUTOMATION=1
RESEARCH_TIME=09:00
RESEARCH_DAILY_LIMIT=20

# The hosted service sends only approved contacts with permission evidence.
AUTO_SEND=0
AUTO_SEND_TIME=10:00
AUTO_SEND_LIMIT=10
